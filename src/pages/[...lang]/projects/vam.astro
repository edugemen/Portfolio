---
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getImage } from "../../../lib/images";
import Text from "../../../components/Text.astro";
import { getLangFromUrl, getTranslation } from "../../../lang/utils";

export function getStaticPaths() {
    return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
---

<Layout title={`VAM | Eduardo Guerrero`} description={getTranslation("projects.1.title", lang)}>
    <main id="main">
        <Image src={getImage("vam_portada.webp")} widths={[800, 1200, 1920]} sizes="(max-width: 1000px) 90vw, 60vw" loading="eager" fetchpriority="high" alt="Portada web de VAM" />
        <section class="text__section">
            <Text type="h1" size={2} class="primary" id="projects.1.title" />
            <Text type="p" size={4} class="tertiary" id="projects.1.description.1" />
            <Text type="p" size={4} class="tertiary" id="projects.1.description.2" />
            <a
                class="link"
                rel="noopener noreferrer"
                target="_blank"
                href="https://vamcv.es">vamcv.es</a
            >
        </section>
        <Image
            src={getImage("vam_1.webp")} widths={[800, 1200, 1920]} sizes="(max-width: 1000px) 90vw, 60vw"
            alt="Captura de la web de VAM. Partido en directo y ultimas publicaciones."
        />
        <Image
            src={getImage("vam_2.webp")} widths={[800, 1200, 1920]} sizes="(max-width: 1000px) 90vw, 60vw"
            alt="Capturas en formato movil. Los ultimos partidos y la clasificacion."
        />
    </main>
</Layout>

<style>
    main {
        margin: 100px auto 0;
        width: 60%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    img {
        width: 100%;
        height: 500px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    h1 {
        color: aliceblue;
    }

    .link {
        color: #2f74c0;
        text-decoration: none;
        font-weight: bold;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .text__section {
        width: 60%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
        border-right: 2px solid white;
        border-left: 2px solid white;
        padding: 10px 20px;
    }

    @media screen and (max-width: 1000px) {
        main {
            width: 90%;
        }

        .text__section {
            width: 85%;
        }
    }
</style>
