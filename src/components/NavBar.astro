---
import MenuIcon from "../icons/menu.svg";
import { ES, GB } from "country-flag-icons/react/3x2";
import Text from "./Text.astro";
import {
    getLangFromUrl,
    getTranslation,
    localizedPath,
    stripLang,
} from "../lang/utils";

const lang = getLangFromUrl(Astro.url);
const other = lang === "es" ? "en" : "es";
const home = localizedPath("/", lang);
const switchHref = localizedPath(stripLang(Astro.url.pathname), other);
const isHome = stripLang(Astro.url.pathname) === "/";
---

<nav class="topnav" id="myTopnav" aria-label="Principal">
    <a href={home} aria-current={isHome ? "page" : undefined}>
        <Text type="span" size={4} id="nav.home" />
    </a>
    <a href={`${home}#experience`}>
        <Text type="span" size={4} id="nav.experience" />
    </a>
    <a href={`${home}#projects`}>
        <Text type="span" size={4} id="nav.projects" />
    </a>
    <a href={`${home}#contact`}>
        <Text type="span" size={4} id="nav.contact" />
    </a>
    <a
        class="lang-selector"
        href={switchHref}
        hreflang={other}
        lang={other}
        aria-label={getTranslation("nav.switch", other)}
    >
        {lang === "en" ? <GB aria-hidden="true" /> : <ES aria-hidden="true" />}
    </a>
    <button
        id="menu"
        type="button"
        aria-label={getTranslation("nav.menu", lang)}
        aria-controls="myTopnav"
        aria-expanded="false"
    >
        <MenuIcon width={30} height={30} aria-hidden="true" />
    </button>
</nav>

<script>
    const nav = document.getElementById("myTopnav")!;
    const menu = document.getElementById("menu")!;

    const setOpen = (open: boolean) => {
        nav.classList.toggle("responsive", open);
        menu.setAttribute("aria-expanded", String(open));
    };

    menu.addEventListener("click", () => {
        setOpen(menu.getAttribute("aria-expanded") !== "true");
    });
    addEventListener("scroll", () => setOpen(false), { passive: true });
    addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            setOpen(false);
            menu.focus();
        }
    });
    nav.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => setOpen(false))
    );
</script>

<style>
    nav {
        width: 100%;
        height: 3rem;
        position: fixed;
        top: 0;
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        color: white;
        backdrop-filter: blur(20px);
        mask: linear-gradient(0deg, transparent, rgba(0, 0, 0, 0.966) 5%);
        z-index: 3;
    }

    .lang-selector {
        padding: 0 0.5em;
    }

    .lang-selector :global(svg) {
        width: 30px;
        height: auto;
    }

    ul {
        position: relative;
        padding: 0;
        margin: 0;
        height: 3em;
        display: flex;
        justify-content: center;
        align-items: center;
        list-style: none;
    }

    nav a {
        display: flex;
        height: 100%;
        align-items: center;
        padding: 0 1em;
        color: white;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        transition: color 0.2s linear;
    }

    a:hover {
        background-color: #00000080;
    }

    nav #menu {
        display: none;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
    }

    nav a:focus-visible,
    nav #menu:focus-visible {
        outline: 2px solid white;
        outline-offset: -2px;
    }

    @media (max-width: 700px) {
        nav a:not(.lang-selector) {
            display: none;
        }
        nav #menu {
            float: right;
            display: block;
        }
        nav.responsive {
            flex-direction: column;
            height: auto;
            padding: 20px 0;
        }
        nav.responsive a {
            display: flex;
            justify-content: center;
            margin: 10px 0;
        }
    }
</style>
