---
import { Image } from "astro:assets";
import Text from "./Text.astro";
import { getImage } from "../lib/images";
import { getLangFromUrl, getTranslation } from "../lang/utils";
const { img, title, empresa, date, description, link } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const image = getImage(img);
---

<section class="exp__section">
    <Image
        src={image}
        alt={getTranslation(empresa, lang)}
        width={400}
        loading="lazy"
        decoding="async"
    />
    <div class="exp__text">
        <Text type="h3" size={2} class="primary" id={title} />
        <Text type="p" size={3} id={empresa} />
        <Text type="p" size={4} class="secondary" id={date} />
        <Text type="p" id={description} />
        {
            link && (
                <a href={link} target="_blank" rel="noopener noreferrer">
                    <Text type="none" id="experience.link" />
                    <span class="sr-only">
                        - <Text type="none" id={empresa} />
                        {getTranslation("link.newtab", lang)}
                    </span>
                </a>
            )
        }
    </div>
</section>

<style>
    .exp__section {
        width: 60%;
        display: flex;
        justify-content: start;
        align-items: start;
        flex-direction: row;
        padding: 20px;
        gap: 24px;
    }

    .exp__section div {
        display: flex;
        flex-direction: column;
        align-items: start;
    }

    .exp__section img {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        align-self: center;
    }

    .exp__text {
        gap: 6px;
    }

    .exp__section :global(h3) {
        margin: 0;
        line-height: 1.3;
    }

    .exp__section :global(p) {
        margin: 0;
        line-height: 1.45;
    }

    a {
        text-decoration: none;
        color: rgb(87, 191, 255);
        font-size: 1.2rem;
        font-weight: bold;
        transition: color 100ms ease;
        margin-top: 8px;
    }

    a:hover {
        color: rgb(255, 255, 255);
    }

    /* breakpoint between 550px and 800px */
    @media (max-width: 1000px) {
        .exp__section {
            width: 90%;
            flex-direction: column;
        }

        .exp__section img {
            flex: 1;
        }

        .exp__section {
            gap: 20px;
        }
    }
</style>
