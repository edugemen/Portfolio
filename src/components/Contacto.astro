---
import Text from "./Text.astro";
import { getLangFromUrl, getTranslation } from "../lang/utils";

const lang = getLangFromUrl(Astro.url);
---

<form
    class="contact__form"
    id="contact__form"
    method="POST"
    data-sending={getTranslation("contact.sending", lang)}
    data-sent={getTranslation("contact.sent", lang)}
    data-error={getTranslation("contact.error", lang)}
>
    <label for="contact__name">
        <Text type="span" size={4} id="contact.name" />
    </label>
    <input
        type="text"
        id="contact__name"
        name="name"
        autocomplete="name"
        required
    />
    <label for="contact__mail">
        <Text type="span" size={4} id="contact.email" />
    </label>
    <input
        type="email"
        id="contact__mail"
        name="mail"
        autocomplete="email"
        required
    />
    <label for="contact__message">
        <Text type="span" size={4} id="contact.message" />
    </label>
    <textarea id="contact__message" name="message" required></textarea>
    <button type="submit" id="contact__button">
        <span id="contact__button-label" class="fs-4"
            ><Text type="none" id="contact.send" /></span
        >
    </button>
</form>

<script>
    import emailjs from "@emailjs/browser";
    import { toast } from "sonner";

    emailjs.init("G7HORSmDTHt5bFrzO");

    const form = document.getElementById("contact__form") as HTMLFormElement;
    const button = document.getElementById("contact__button") as HTMLButtonElement;
    const label = document.getElementById("contact__button-label")!;
    const idleText = label.textContent;

    form.addEventListener("submit", (e) => {
        e.preventDefault();

        if (!form.reportValidity()) {
            return;
        }

        button.disabled = true;
        label.textContent = form.dataset.sending ?? "";

        emailjs
            .sendForm("service_4vlnrd5", "contact_form", form)
            .then(() => {
                form.reset();
                toast.success(form.dataset.sent);
            })
            .catch(() => {
                toast.error(form.dataset.error);
            })
            .finally(() => {
                button.disabled = false;
                label.textContent = idleText;
            });
    });
</script>

<style>
    .contact__form {
        display: flex;
        flex-direction: column;
        align-items: start;
        justify-content: center;
        width: 40%;
        height: 100%;
        margin-top: 50px;
    }

    .contact__form input,
    .contact__form textarea {
        width: calc(100% - 20px);
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ccc;
        font-size: 16px;
        resize: none;
        margin-bottom: 20px;
        margin-top: 5px;
    }

    .contact__form textarea {
        height: 150px;
    }

    .contact__form button {
        padding: 10px 20px;
        border-radius: 5px;
        border: none;
        background-color: #005fcc;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        align-self: flex-end;
        transition: background-color 0.3s ease;
    }

    .contact__form button:hover {
        background-color: #004fa8;
    }

    @media (max-width: 700px) {
        .contact__form {
            width: 90%;
        }
    }
</style>
