---
const { size } = Astro.props;
import AvatarSvg from "../icons/avatar.svg";
---

<div class="avatar" aria-hidden="true">
    <AvatarSvg />
</div>

<style define:vars={{ size }}>
    .avatar :global(svg) {
        width: var(--size);
        height: var(--size);
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    .avatar {
        position: relative;
        width: calc(var(--size) - 10px);
        height: calc(var(--size) - 10px);
        border-radius: 50%;
        background-color: #3959ac;
        overflow: hidden;
    }
</style>
