---
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { Toaster } from "sonner";
import NavBar from "../components/NavBar.astro";
import "../components/text.css";
import {
    getLangFromUrl,
    getTranslation,
    localizedPath,
    stripLang,
    languages,
    type Language,
} from "../lang/utils";

interface Props {
    title: string;
    description?: string;
    home?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const { title, home = false } = Astro.props;
const description = Astro.props.description ?? getTranslation("meta.description", lang);
const basePath = stripLang(Astro.url.pathname);
const site = Astro.site!;
const urlFor = (l: Language) => new URL(localizedPath(basePath, l), site).href;
const canonical = urlFor(lang);
const image = new URL("/portada.webp", site).href;
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Eduardo Guerrero",
    url: site.href,
    jobTitle: getTranslation("info.dev", lang),
    description: getTranslation("meta.description", lang),
    image: image,
    sameAs: [
        "https://github.com/edugemen",
        "https://www.linkedin.com/in/edugemen/",
    ],
};
const breadcrumbLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: getTranslation("nav.home", lang),
            item: new URL(localizedPath("/", lang), site).href,
        },
        { "@type": "ListItem", position: 2, name: title, item: canonical },
    ],
};
const otherLang = (Object.keys(languages) as Language[]).find((l) => l !== lang)!;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <meta name="theme-color" content="#13151a" />
        <meta name="author" content="Eduardo Guerrero" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
        <link rel="canonical" href={canonical} />
        {
            (Object.keys(languages) as Language[]).map((l) => (
                <link rel="alternate" hreflang={l} href={urlFor(l)} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={urlFor("es")} />

        <meta property="og:type" content={home ? "profile" : "website"} />
        <meta property="og:site_name" content="Eduardo Guerrero" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1920" />
        <meta property="og:image:height" content="1080" />
        <meta property="og:image:alt" content={title} />
        <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
        <meta property="og:locale:alternate" content={otherLang === "es" ? "es_ES" : "en_US"} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={title} />
        <meta
            name="google-site-verification"
            content="i_MXlfiGK0q9pCFIarNrZQ5rka37d5JlBGKlEEhnekI"
        />
        <script type="speculationrules" is:inline>
            {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
        </script>
        {home && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
        {!home && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    </head>
    <body>
        <a class="skip-link" href="#main">{getTranslation("nav.skip", lang)}</a>
        <NavBar />
        <slot />
        <Toaster client:idle />

        <script>
            const cards = Array.from(
                document.querySelectorAll<HTMLElement>(".card__container")
            );

            const updateCards = () => {
                const pos = cards.map((c) => [c.offsetLeft, c.offsetTop]);
                cards.forEach((c, i) =>
                    c.setAttribute(
                        "style",
                        `--xx: ${pos[i][0]}px; --yy:${pos[i][1]}px;`
                    )
                );
            };

            requestAnimationFrame(updateCards);

            let resizeRaf = 0;
            addEventListener(
                "resize",
                () => {
                    cancelAnimationFrame(resizeRaf);
                    resizeRaf = requestAnimationFrame(updateCards);
                },
                { passive: true }
            );

            let moveRaf = 0;
            let lastEvent: PointerEvent;
            document.body.addEventListener(
                "pointermove",
                (e) => {
                    lastEvent = e;
                    if (moveRaf) return;
                    moveRaf = requestAnimationFrame(() => {
                        moveRaf = 0;
                        document.body.setAttribute(
                            "style",
                            `--opacity: 1; --x: ${lastEvent.pageX}px; --y:${lastEvent.pageY}px;`
                        );
                    });
                },
                { passive: true }
            );
        </script>

        <style is:global>
            :root {
                /* background-color: hsl(194, 100%, 75%); */
                --accent: 200, 76%, 53%;
                --accent-light: 224, 204, 250;
                --accent-dark: 49, 10, 101;
                --accent-gradient: linear-gradient(
                    45deg,
                    rgb(var(--accent)),
                    rgb(var(--accent-light)) 30%,
                    white 60%
                );
            }
            html {
                font-family: "Inter Variable", "Inter", sans-serif;
                background: #13151a;
                background-size: 224px;
                scroll-behavior: smooth;
                scroll-padding-top: 4rem;
            }
            code {
                font-family:
                    Menlo,
                    Monaco,
                    Lucida Console,
                    Liberation Mono,
                    DejaVu Sans Mono,
                    Bitstream Vera Sans Mono,
                    Courier New,
                    monospace;
            }
            body {
                position: relative;
            }
        </style>
    </body>
</html>
